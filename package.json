{
  "name": "pi-skills-mention",
  "version": "0.1.0",
  "type": "module",
  "description": "Codex-style `$skill-name` mentions for pi: expand any number of skills anywhere in a prompt, with live `$`-triggered skill autocompletion in the TUI.",
  "author": "wufei",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "skills",
    "mention",
    "autocomplete",
    "codex"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": ">=0.80.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
