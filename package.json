  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "codex",
    "codex-style",
    "skill",
    "skills",
    "skill-mention",
    "mention",
    "$",
    "autocomplete",
    "completion",
    "prompt"
  ],
  "files": [
    "src",
    "dist",
    "README.md",
    "README.zh.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@earendil-works/pi-tui": ">=0.83.0"
  },
